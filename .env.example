# ═══════════════════════════════════════════════════════════════════
# CIVELLA — Frontend Environment Template · RSP-FE-BP-2026
# Copy to .env and fill values. Vite inlines ONLY VITE_-prefixed
# vars at build time — they are PUBLIC by definition.
# Never put secrets (API keys, service roles) in VITE_ vars.
# Non-VITE_ vars are NOT exposed to the browser.
# ═══════════════════════════════════════════════════════════════════

# ── App identity
VITE_APP_NAME="Civella"                 # Display name shown across the UI
VITE_APP_TAGLINE="Premium Property Discovery"

# ── API base URL
# EMPTY  → bundled mock JSON in src/data/ (default dev/demo mode)
# SET    → real REST endpoints; zero code changes required
VITE_API_URL=""

# ── Map (listings map view)
VITE_MAP_STYLE_URL="https://demotiles.maplibre.org/style.json"
VITE_MAP_ACCESS_TOKEN=""

# ── Feature flags (boolean strings — parsed in src/lib/constants/flags.ts)
VITE_FLAG_SAVED_SEARCHES="true"   # saved search + alert UI
VITE_FLAG_PREQUAL_WIZARD="true"   # 6-step pre-qual wizard (Project 3)
VITE_FLAG_BROKER_PORTAL="true"    # broker dashboard + lead inbox (Project 3)
VITE_FLAG_CRM_TRIAL="true"        # 14-day trial badge + messaging (Project 2)
VITE_FLAG_VIRTUAL_TOUR="false"    # enable tour slot when client supplies URLs

# ── Analytics (optional — empty = tracking disabled)
VITE_ANALYTICS_URL=""

# ── Build metadata (set by CI at build time)
VITE_BUILD_DATE=""
VITE_BUILD_SHA=""
